/**
 * @brief[zh-cn] DFG LUT 纹理单例缓存
 *
 * @brief[en] DFG LUT texture singleton cache
 */
private var dfgLutCache: Option<DataTexture> = None<DataTexture>

/**
 * @brief[zh-cn] 获取 DFG LUT 数据纹理
 * @explain[zh-cn] 首次调用时创建 DataTexture 并填充 DFG_LUT_DATA 数据;
 * 后续调用返回缓存的纹理单例。
 * 纹理属性:
 * - 名称: 'DFG_LUT'
 * - 分辨率: 16x16
 * - 格式: RGFormat + HalfFloatType
 * - 过滤: LinearFilter
 * - 包裹: ClampToEdgeWrapping
 * - 不生成 mipmap
 * @return[zh-cn] DFG LUT 数据纹理
 *
 * @brief[en] Get the DFG LUT data texture
 * @explain[en] Creates a DataTexture filled with DFG_LUT_DATA on first call;
 * subsequent calls return the cached texture singleton.
 * Texture properties:
 * - Name: 'DFG_LUT'
 * - Resolution: 16x16
 * - Format: RGFormat + HalfFloatType
 * - Filter: LinearFilter
 * - Wrap: ClampToEdgeWrapping
 * - No mipmap generation
 * @return[en] DFG LUT data texture
 */
public func getDFGLUT(): DataTexture {
    if (dfgLutCache.isSome()) {
        return dfgLutCache.getOrThrow()
    }

    // 将 UInt16 数组转换为 UInt8 字节数据(每个 UInt16 占 2 字节,小端序)
    let byteData = Array<UInt8>(DFG_LUT_DATA.size * 2, { _ => 0u8 })
    for (i in 0..DFG_LUT_DATA.size) {
        let v: UInt16 = DFG_LUT_DATA[i]
        byteData[i * 2] = UInt8(v & 0xFFu16)
        byteData[i * 2 + 1] = UInt8((v >> 8) & 0xFFu16)
    }

    let lut = DataTexture(byteData, 16, 16, format: RGFormat, `type`: HalfFloatType)
    lut.name = "DFG_LUT"
    lut.minFilter = LinearFilter
    lut.magFilter = LinearFilter
    lut.wrapS = ClampToEdgeWrapping
    lut.wrapT = ClampToEdgeWrapping
    lut.generateMipmaps = false
    lut.needsUpdate = true

    dfgLutCache = Some(lut)
    return lut
}
