/**
 * @file[zh-cn] 车削几何体
 * @brief[zh-cn] 将一组 2D 轮廓点绕 Y 轴旋转生成的旋转体几何体
 * @explain[zh-cn] 
 * LatheGeometry 继承自 BufferGeometry，将一组 2D 点绕 Y 轴旋转指定弧度生成旋转体。
 * 对应 Three.js geometries/LatheGeometry.js。
 *
 * @file[en] Lathe Geometry
 * @brief[en] Geometry generated by rotating a set of 2D profile points around the Y-axis
 * @explain[en] 
 * LatheGeometry extends BufferGeometry, rotating a set of 2D points around the Y-axis by a specified arc to generate a solid of revolution.
 * Corresponds to Three.js geometries/LatheGeometry.js.
 */
package three.rendering.geometry

import three.rendering.buffer.*
import three.core.math.*
import std.collection.*
import std.math.*

/**
 * @brief[zh-cn] 车削几何体类
 * @explain[zh-cn] 
 * 将一组 2D 轮廓点绕 Y 轴旋转生成旋转体，支持分段数、起始角和旋转弧度参数。
 *
 * @brief[en] Lathe geometry class
 * @explain[en] 
 * Rotates a set of 2D profile points around the Y-axis to generate a solid of revolution, supporting segments, start angle, and arc length parameters.
 */
public class LatheGeometry <: BufferGeometry {
    /**
     * @brief[zh-cn] 构造参数
     *
     * @brief[en] Construction parameters
     */
    public var parameters: HashMap<String, Any>

    /**
     * @brief[zh-cn] 构造车削几何体
     * @param[zh-cn] points 2D 轮廓点数组
     * segments 圆周分段数，默认 12
     * phiStart 起始角（弧度），默认 0
     * phiLength 旋转弧度，默认 2π
     *
     * @brief[en] Constructs a lathe geometry
     * @param[en] points Array of 2D profile points
     * segments Circumferential segments, default 12
     * phiStart Start angle in radians, default 0
     * phiLength Arc length in radians, default 2π
     */
    public init(points: Array<Vector2>, segments!: Int64 = 12, phiStart!: Float64 = 0.0, phiLength!: Float64 = PI * 2.0) {
        super()
        this.kind = "LatheGeometry"
        this.parameters = HashMap<String, Any>()
        this.parameters.add("points", points); this.parameters.add("segments", segments)
        this.parameters.add("phiStart", phiStart); this.parameters.add("phiLength", phiLength)

        let seg = max(3, segments)
        let pLen = points.size
        let invSeg = 1.0 / Float64(seg)
        let vertices = ArrayList<Float64>(); let normals = ArrayList<Float64>(); let uvs = ArrayList<Float64>()
        let indices = ArrayList<Int64>()

        // pre-compute initNormals
        let initNormals = ArrayList<Float64>()
        var prevNx = 0.0; var prevNy = 0.0; var prevNz = 0.0
        for (j in 0..pLen) {
            if (j == 0) {
                prevNx = points[j + 1].y - points[j].y
                prevNy = -(points[j + 1].x - points[j].x)
                prevNz = 0.0
                let nlen = sqrt(prevNx * prevNx + prevNy * prevNy + prevNz * prevNz)
                initNormals.add(prevNx / nlen); initNormals.add(prevNy / nlen); initNormals.add(prevNz / nlen)
            } else if (j == pLen - 1) {
                initNormals.add(prevNx); initNormals.add(prevNy); initNormals.add(prevNz)
            } else {
                let dx = points[j + 1].x - points[j].x
                let dy = points[j + 1].y - points[j].y
                let nx = dy; let ny = -dx; let nz = 0.0
                let len = sqrt(nx * nx + ny * ny + nz * nz)
                let cxn = nx + prevNx; let cyn = ny + prevNy; let czn = nz + prevNz
                let clen = sqrt(cxn * cxn + cyn * cyn + czn * czn)
                if (clen > 0.0) { initNormals.add(cxn / clen); initNormals.add(cyn / clen); initNormals.add(czn / clen) }
                else { initNormals.add(0.0); initNormals.add(0.0); initNormals.add(1.0) }
                prevNx = nx; prevNy = ny; prevNz = nz
            }
        }

        for (i in 0..=seg) {
            let phi = phiStart + Float64(i) * invSeg * phiLength
            let s = sin(phi); let c = cos(phi)
            for (j in 0..pLen) {
                vertices.add(points[j].x * s); vertices.add(points[j].y); vertices.add(points[j].x * c)
                uvs.add(Float64(i) / Float64(seg)); uvs.add(Float64(j) / Float64(pLen - 1))
                let nx = initNormals[j * 3] * s
                let ny = initNormals[j * 3 + 1]
                let nz = initNormals[j * 3] * c
                normals.add(nx); normals.add(ny); normals.add(nz)
            }
        }

        for (i in 0..seg) {
            for (j in 0..(pLen - 1)) {
                let base = j + i * pLen
                indices.add(base); indices.add(base + 1); indices.add(base + pLen)
                indices.add(base + pLen); indices.add(base + 1); indices.add(base + pLen + 1)
            }
        }

        let idxArr = Array<Float64>(indices.size, { i => Float64(indices[i]) })
        this.setIndex(BufferAttribute(idxArr, 1))
        this.setAttribute("position", BufferAttribute(vertices.toArray(), 3))
        this.setAttribute("normal", BufferAttribute(normals.toArray(), 3))
        this.setAttribute("uv", BufferAttribute(uvs.toArray(), 2))
    }
}