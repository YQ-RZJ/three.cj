 *
 * @file[zh-cn] JsonSerializer JSON 序列化便捷工具类
 * @brief[zh-cn] JSON 序列化便捷工具类（一行调用）
 * @explain[zh-cn] 提供最常用的 JSON 转换入口，封装 fastjson 的流式创建/配置细节：toJson(obj) 对象转 JSON 字符串；fromJson<T>(json) JSON 字符串转对象。依赖 @JsonAdapter 宏生成的对象成员方法。
 *
 * @file[en] JsonSerializer  JSON serialization utility class
 * @brief[en] JSON serialization utility class (one-line invocation)
 * @explain[en] Provides the most commonly used JSON conversion entry points, wrapping fastjson's stream creation/configuration details: toJson(obj) converts objects to JSON strings; fromJson<T>(json) converts JSON strings to objects. Depends on @JsonAdapter macro-generated object member methods.
 */
package three.resource.serializer

import fastjson.stream.*

/**
 * @brief[zh-cn] JSON 序列化便捷工具类
 *
 * @brief[en] JSON serialization utility class
 */
public class JsonSerializer {
    /**
     * @brief[zh-cn] 对象转 JSON 字符串
     * @explain[zh-cn] 等价于 obj.toJson()（接口默认实现：自动创建 ByteBuffer 流 + flush）。
     * @param[zh-cn] obj 实现 JsonStreamSerializable 的对象（@JsonAdapter 自动生成）
     * @return[zh-cn] JSON 字符串
     *
     * @brief[en] Convert object to JSON string
     * @explain[en] Equivalent to obj.toJson() (interface default implementation: auto-creates ByteBuffer stream + flush).
     * @param[en] obj Object implementing JsonStreamSerializable (auto-generated by @JsonAdapter)
     * @return[en] JSON string
     */
    public static func toJson(obj: JsonStreamSerializable): String {
        return obj.toJson()
    }

    /**
     * @brief[zh-cn] JSON 字符串转对象
     * @explain[zh-cn] 等价于 T.fromJson(json)（接口默认实现：自动创建 ByteBuffer 流）。
     * @param[zh-cn] json JSON 字符串
     * @return[zh-cn] 反序列化出的 T 实例
     *
     * @brief[en] Convert JSON string to object
     * @explain[en] Equivalent to T.fromJson(json) (interface default implementation: auto-creates ByteBuffer stream).
     * @param[en] json JSON string
     * @return[en] Deserialized T instance
     */
    public static func fromJson<T>(json: String): T where T <: JsonStreamDeserializable<T> {
        return T.fromJson(json)
    }

    /**
     * @brief[zh-cn] 对象转 JSON 字节（UTF-8）
     * @param[zh-cn] obj 实现 JsonStreamSerializable 的对象
     * @return[zh-cn] UTF-8 编码的 JSON 字节数组
     *
     * @brief[en] Convert object to JSON bytes (UTF-8)
     * @param[en] obj Object implementing JsonStreamSerializable
     * @return[en] UTF-8 encoded JSON byte array
     */
    public static func toJsonBytes(obj: JsonStreamSerializable): Array<Byte> {
        return obj.toJson().toArray()
    }

    /**
     * @brief[zh-cn] JSON 字节（UTF-8）转对象
     * @param[zh-cn] jsonBytes UTF-8 编码的 JSON 字节数组
     * @return[zh-cn] 反序列化出的 T 实例
     *
     * @brief[en] Convert JSON bytes (UTF-8) to object
     * @param[en] jsonBytes UTF-8 encoded JSON byte array
     * @return[en] Deserialized T instance
     */
    public static func fromJsonBytes<T>(jsonBytes: Array<Byte>): T where T <: JsonStreamDeserializable<T> {
        return T.fromJson(String.fromUtf8(jsonBytes))
    }

    /**
     * @brief[zh-cn] 判断 JSON 字符串是否合法（可解析为指定类型）
     * @param[zh-cn] json JSON 字符串
     * @return[zh-cn] true 表示可解析
     *
     * @brief[en] Check if JSON string is valid (parsable as specified type)
     * @param[en] json JSON string
     * @return[en] true if parsable
     */
    public static func isValidJson<T>(json: String): Bool where T <: JsonStreamDeserializable<T> {
        try {
            T.fromJson(json)
            return true
        } catch (_: Exception) {
            return false
        }
    }
}
