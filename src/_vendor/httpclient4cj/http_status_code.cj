protected package three._vendor.httpclient4cj

/**
 * @brief HTTP status code constants
 */
public class HttpStatusCode {
    public static let STATUS_CONTINUE: Int64 = 100
    public static let STATUS_OK: Int64 = 200
    public static let STATUS_NO_CONTENT: Int64 = 204
    public static let STATUS_NOT_MODIFIED: Int64 = 304
    public static let STATUS_REQUEST_TIMEOUT: Int64 = 408
    public static let STATUS_SERVICE_UNAVAILABLE: Int64 = 503
}